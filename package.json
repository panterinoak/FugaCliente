{
  "name": "fugacliente",
  "version": "2.0.0",
  "description": "Plataforma de detección explicable de clientes en riesgo de fuga por mal servicio: API REST en capas con Express, SQL Server y MongoDB, e interfaz web.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "demo": "node scripts/demo.js",
    "db:setup": "node scripts/setup-db.js",
    "db:seed": "node scripts/seed-db.js",
    "docs:api": "node scripts/generate-api-docs.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "check": "node scripts/check.js",
    "doctor": "node scripts/doctor.js",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.0.0",
    "mssql": "^12.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  },
  "keywords": [
    "express",
    "sql-server",
    "mongodb",
    "rest",
    "churn",
    "retention",
    "outbox"
  ]
}
