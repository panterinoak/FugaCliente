{
  "info": {
    "name": "FugaCliente · Evaluación Parcial",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecuta en orden: login, catálogos, crear cliente, crear incidencia, actualizar estado y crear seguimiento. Configura email/password para tu .env. JWT e IDs se guardan automáticamente."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "email",
      "value": "admin@fugacliente.local"
    },
    {
      "key": "password",
      "value": "FugaCliente2026!"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "clientId",
      "value": ""
    },
    {
      "key": "incidentId",
      "value": ""
    },
    {
      "key": "actionId",
      "value": ""
    },
    {
      "key": "userId",
      "value": "1"
    },
    {
      "key": "segmentId",
      "value": "1"
    },
    {
      "key": "serviceId",
      "value": "1"
    },
    {
      "key": "categoryId",
      "value": "1"
    },
    {
      "key": "version",
      "value": "1"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 · Salud de las bases",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 · Login y guardar token",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code < 300) pm.collectionVariables.set('token', pm.response.json().data.token);",
              "if (pm.response.code === 200) pm.collectionVariables.set('userId', pm.response.json().data.user.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 · Catálogos y guardar IDs",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/catalogs"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const c = pm.response.json().data; if (c) { pm.collectionVariables.set('segmentId',c.segments[0].id); pm.collectionVariables.set('serviceId',c.services[0].id); pm.collectionVariables.set('categoryId',c.categories[0].id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "04 · Perfil",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/users/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 · Crear cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/clients",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Cliente Postman\",\n  \"email\": \"cliente-{{$timestamp}}@example.com\",\n  \"phone\": \"+51 999 999 999\",\n  \"segmentId\": \"{{segmentId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code < 300) pm.collectionVariables.set('clientId', pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 · Listar clientes",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/clients?limit=20&page=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 · Riesgo del cliente",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/clients/{{clientId}}/risk"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 · Registrar incidencia",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/incidents",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"serviceId\": \"{{serviceId}}\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"description\": \"El cliente reporta mala atención y solicita una solución.\",\n  \"severity\": 3,\n  \"satisfaction\": 1,\n  \"assignedUserId\": \"{{userId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code < 300) pm.collectionVariables.set('incidentId', pm.response.json().data.id);",
              "if (pm.response.code < 300) pm.collectionVariables.set('version', pm.response.json().data.version);"
            ]
          }
        }
      ]
    },
    {
      "name": "09 · Listar incidencias",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/incidents?clientId={{clientId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 · Resolver incidencia",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/incidents/{{incidentId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"resuelta\",\n  \"expectedVersion\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code < 300) pm.collectionVariables.set('version', pm.response.json().data.version);"
            ]
          }
        }
      ]
    },
    {
      "name": "11 · Registrar acción",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/retention-actions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"incidentId\": \"{{incidentId}}\",\n  \"assignedUserId\": \"{{userId}}\",\n  \"type\": \"seguimiento\",\n  \"description\": \"Llamar al cliente y confirmar que recibió la solución.\",\n  \"dueAt\": \"{{dueAt}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('dueAt', new Date(Date.now()+86400000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code < 300) pm.collectionVariables.set('actionId', pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "12 · Completar acción",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/retention-actions/{{actionId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"outcome\": \"recuperado\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 · Agregar comentario BSON",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/clients/{{clientId}}/comments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"El cliente confirmó que recibió la solución.\",\n  \"channel\": \"telefono\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 · Consultar comentarios",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/clients/{{clientId}}/comments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 · Indicadores",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/dashboard"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "16 · Alertas",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/alerts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "17 · Auditoría del cliente",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/logs?clientId={{clientId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "18 · Validación inválida",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/clients",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"A\",\n  \"email\": \"no-es-correo\",\n  \"segmentId\": \"{{segmentId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "19 · Versión obsoleta",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/incidents/{{incidentId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"en_proceso\",\n  \"expectedVersion\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "20 · Archivar cliente",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/clients/{{clientId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}
