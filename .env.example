# Copiar como .env. No subir .env al repositorio.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# sqlmongo es el modo que cumple la rúbrica. npm run demo usa memoria temporal.
DB_MODE=sqlmongo
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRES_IN=2h
SQL_HOST=localhost
SQL_PORT=1433
SQL_DATABASE=FugaCliente
SQL_USER=sa
# Debe coincidir con MSSQL_SA_PASSWORD del compose.
SQL_PASSWORD=FugaLocal2026!Cambiar
SQL_ENCRYPT=false
SQL_TRUST_CERT=true
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=fugacliente
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@fugacliente.local
ADMIN_PASSWORD=FugaCliente2026!
OUTBOX_INTERVAL_MS=3000
# Número de proxies inversos de confianza (0 en local). Afecta la IP usada por el rate limit.
TRUST_PROXY=0
LOG_RETENTION_DAYS=90
